// キーの表記 ("Ctrl+Shift+F7" など) を出すチップ。removable なら右に × を出す

import { Theme, Icons } from "../theme.slint";

export component KeyChip inherits Rectangle {
    in property <string> text;
    in property <bool> removable;

    callback remove();

    background: Theme.chip-background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.chip-stroke;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: root.removable ? 2px : 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 2px;

        Text {
            text: root.text;
            font-size: Theme.caption-size;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        if root.removable: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: Theme.radius;
            background: remove-touch.pressed ? Theme.subtle-pressed : remove-touch.has-hover ? Theme.subtle-hover : transparent;
            accessible-role: button;
            accessible-label: "\{root.text} を削除";
            accessible-action-default => {
                root.remove();
            }

            Text {
                text: Icons.dismiss;
                font-family: Theme.icon-font;
                font-size: 10px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            remove-touch := TouchArea {
                clicked => {
                    root.remove();
                }
            }
        }
    }
}
