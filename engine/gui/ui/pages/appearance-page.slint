// 見た目のページ

import { Button, ComboBox, Switch } from "std-widgets.slint";
import { Card } from "../components/card.slint";
import { SettingsPage, SectionHeader } from "../components/page.slint";
import { Theme } from "../theme.slint";

// 入力パネルの見本 1 つ。DLL が描いた画像を実物と同じ画素の大きさ (1phx) で、文書を模した背景の上に
// 出す。領域より広い見本は縮小せずに右側を切る
component PreviewSample {
    in property <string> title;
    in property <image> source;
    in property <bool> dark;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.title;
            font-size: Theme.caption-size;
            color: Theme.text-secondary;
        }

        Rectangle {
            min-width: 0px;
            height: root.source.height * 1phx + 24px;
            background: root.dark ? Theme.preview-background-dark : Theme.preview-background-light;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-stroke;
            clip: true;
            accessible-role: image;
            accessible-label: root.title + "の見本";

            Image {
                x: 12px;
                y: 12px;
                width: root.source.width * 1phx;
                height: root.source.height * 1phx;
                source: root.source;
                accessible-role: none;
            }
        }
    }
}

export component AppearancePage inherits SettingsPage {
    in property <[string]> theme-choices;
    in-out property <int> theme-index;
    in property <[string]> font-choices;
    in-out property <int> font-index;
    in property <[string]> font-size-choices;
    in-out property <int> font-size-index;
    in-out property <bool> mode-popup;
    in property <image> preview-bar;
    in property <image> preview-conversion;
    // 見本のテーマをダークの配色で解決した (見本の背景を合わせる)
    in property <bool> preview-dark;
    in property <bool> preview-blur;
    // 見本を描けなかった理由。空でなければ見本の代わりに出す
    in property <string> preview-error;

    callback changed();
    callback open-theme-dir();

    title: "見た目";

    Card {
        title: "入力パネルのテーマ";

        ComboBox {
            min-width: 200px;
            model: root.theme-choices;
            current-index <=> root.theme-index;
            accessible-label: "入力パネルのテーマ";
            selected => {
                root.changed();
            }
        }

        Button {
            text: "テーマのフォルダを開く";
            clicked => {
                root.open-theme-dir();
            }
        }
    }

    Card {
        title: "フォント";

        ComboBox {
            min-width: 200px;
            model: root.font-choices;
            current-index <=> root.font-index;
            accessible-label: "フォント";
            selected => {
                root.changed();
            }
        }
    }

    Card {
        title: "サイズ";

        ComboBox {
            model: root.font-size-choices;
            current-index <=> root.font-size-index;
            accessible-label: "サイズ";
            selected => {
                root.changed();
            }
        }
    }

    Card {
        title: "オン/オフの切り替え時に「あ」「A」を表示する";

        Switch {
            checked <=> root.mode-popup;
            accessible-label: "オン/オフの切り替え時に「あ」「A」を表示する";
            toggled => {
                root.changed();
            }
        }
    }

    SectionHeader {
        text: "プレビュー";
    }

    if root.preview-error != "": Text {
        text: root.preview-error;
        font-size: Theme.body-size;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }

    if root.preview-error == "": VerticalLayout {
        spacing: 12px;

        PreviewSample {
            title: "入力パネル";
            source: root.preview-bar;
            dark: root.preview-dark;
        }

        PreviewSample {
            title: "変換の候補一覧";
            source: root.preview-conversion;
            dark: root.preview-dark;
        }

        if root.preview-blur: Text {
            text: "ぼかしはプレビューでは再現されません";
            font-size: Theme.caption-size;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}
